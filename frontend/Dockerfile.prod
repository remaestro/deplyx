# ── Build stage ────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG VITE_API_URL
ARG VITE_LAB_API_URL
ENV VITE_API_URL=${VITE_API_URL:-/api/v1}
ENV VITE_LAB_API_URL=${VITE_LAB_API_URL:-/api/v1}

RUN npm run build

# ── Production stage ───────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Copy built dist
COPY --from=builder /app/dist /app/dist

# Copy server entry point
COPY server-entry.mjs /app/server-entry.mjs

# Copy package files and install production dependencies only
# (needed by the built SSR server for packages like h3-v2, @tanstack/*, react, etc.)
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund --omit=dev && npm cache clean --force

EXPOSE 8080

CMD ["node", "server-entry.mjs"]
